{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quanticsoul4772.github.io/gev-open-sources/v1/entry.schema.json",
  "title": "Keyless data source entry",
  "type": "object",
  "required": ["id", "domain", "name", "provider", "coverage", "access", "format", "licence", "licence_decision", "provenance"],
  "allOf": [
    {
      "if": { "type": "object", "properties": { "licence": { "type": "object", "properties": { "display": { "const": true } }, "required": ["display"] } }, "required": ["licence"] },
      "then": { "type": "object", "properties": { "licence_decision": { "type": "object", "properties": { "by": { "not": { "const": "none" } } } } } }
    },
    {
      "if": { "type": "object", "properties": { "format": { "const": "cameras.list" } }, "required": ["format"] },
      "then": { "type": "object", "properties": { "mapping": { "type": "object" } }, "required": ["mapping"] }
    }
  ],
  "$defs": {
    "httpUrl": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "lat": { "type": "number", "minimum": -90, "maximum": 90 },
    "lon": { "type": "number", "minimum": -180, "maximum": 180 }
  },
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
    "domain": { "enum": ["transit.vehicles", "bikeshare.stations", "hazards.earthquakes", "cameras.stills"] },
    "name": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "coverage": {
      "type": "object",
      "required": ["bbox", "countries"],
      "properties": {
        "bbox": {
          "description": "[minLat, minLon, maxLat, maxLon]",
          "oneOf": [
            { "type": "null" },
            {
              "type": "array",
              "prefixItems": [{ "$ref": "#/$defs/lat" }, { "$ref": "#/$defs/lon" }, { "$ref": "#/$defs/lat" }, { "$ref": "#/$defs/lon" }],
              "items": false,
              "minItems": 4
            }
          ]
        },
        "countries": { "type": "array", "items": { "type": "string" } }
      }
    },
    "access": {
      "type": "object",
      "required": ["url", "redirectHosts", "unzip", "headers", "min_interval_s"],
      "properties": {
        "url": { "$ref": "#/$defs/httpUrl" },
        "related": { "type": "object", "additionalProperties": { "$ref": "#/$defs/httpUrl" } },
        "redirectHosts": { "type": "array", "items": { "type": "string" } },
        "unzip": { "type": ["string", "null"] },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } },
        "min_interval_s": { "type": "number", "minimum": 0 }
      }
    },
    "format": { "enum": ["gtfs-rt.vehicle-positions", "gbfs.station-status", "geojson.earthquakes", "cameras.list"] },
    "licence": {
      "type": "object",
      "required": ["id", "url", "display", "commercial", "attribution"],
      "properties": {
        "id": { "type": ["string", "null"] },
        "url": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/httpUrl" }] },
        "display": { "type": "boolean" },
        "commercial": { "type": ["boolean", "null"] },
        "attribution": { "type": ["string", "null"] }
      }
    },
    "licence_decision": {
      "type": "object",
      "required": ["by", "evidence"],
      "properties": {
        "by": { "enum": ["known-licence", "gbfs-v3-default", "llm-terms", "none"] },
        "evidence": { "type": "array", "items": { "type": "object" } },
        "terms_sha256": { "type": ["string", "null"] },
        "at": { "type": ["string", "null"] }
      }
    },
    "provenance": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "mapping": {
      "description": "cameras.list: where each camera's fields sit in the list document. Paths are dot segments relative to each item; a number indexes an array; [key=value] picks the array item whose key equals value.",
      "type": "object",
      "required": ["items", "id", "lat", "lon", "image"],
      "properties": {
        "items": { "type": "string", "description": "path from the document to the camera array; empty when the document is the array" },
        "id": { "type": "string" },
        "lat": { "type": "string" },
        "lon": { "type": "string" },
        "image": { "type": "string", "description": "path to the image URL, or to the value put into image_template" },
        "name": { "type": "string" },
        "active": { "type": "string", "description": "path to a flag; items where it is not true are skipped" },
        "image_template": { "type": "string", "pattern": "^https://[!-~]+$", "description": "image URL with {value} replaced by the URL-encoded image value" }
      }
    },
    "health": {
      "description": "Present in published directories, not in entries/. Probe summary over the last 7 days.",
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["candidate", "verified", "degraded", "dead"] },
        "success_7d": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "median_age_s": { "type": ["number", "null"] },
        "records": { "type": ["number", "null"] },
        "last_ok": { "type": ["number", "null"], "description": "epoch seconds of the last probe with records" },
        "last_probe": { "type": ["number", "null"], "description": "epoch seconds" }
      }
    }
  }
}
