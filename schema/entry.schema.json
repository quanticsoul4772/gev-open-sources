{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quanticsoul4772.github.io/gev-open-sources/v1/entry.schema.json",
  "title": "Keyless data source entry",
  "type": "object",
  "required": ["id", "domain", "name", "provider", "coverage", "access", "format", "licence", "licence_decision", "provenance"],
  "allOf": [
    {
      "if": { "type": "object", "properties": { "licence": { "type": "object", "properties": { "display": { "const": true } }, "required": ["display"] } }, "required": ["licence"] },
      "then": { "type": "object", "properties": { "licence_decision": { "type": "object", "properties": { "by": { "not": { "const": "none" } } } } } }
    },
    {
      "if": { "type": "object", "properties": { "format": { "const": "gbfs.vehicle-status" } }, "required": ["format"] },
      "then": { "type": "object", "properties": { "gbfs": { "type": "object", "properties": { "form_factors": { "type": "array" } }, "required": ["form_factors"] } }, "required": ["gbfs"] }
    },
    {
      "if": { "type": "object", "properties": { "format": { "const": "cameras.list" } }, "required": ["format"] },
      "then": { "type": "object", "properties": { "mapping": { "$ref": "#/$defs/cameraMapping" } }, "required": ["mapping"] }
    },
    {
      "if": { "type": "object", "properties": { "format": { "const": "geojson.fire-perimeters" } }, "required": ["format"] },
      "then": { "type": "object", "properties": { "mapping": { "$ref": "#/$defs/perimeterMapping" } }, "required": ["mapping"] }
    }
  ],
  "$defs": {
    "httpUrl": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "lat": { "type": "number", "minimum": -90, "maximum": 90 },
    "lon": { "type": "number", "minimum": -180, "maximum": 180 },
    "cameraMapping": {
      "description": "cameras.list: where each camera's fields sit in the list document. Paths are dot segments relative to each item; a number indexes an array; [key=value] picks the array item whose key equals value.",
      "type": "object",
      "required": ["items", "id", "lat", "lon", "image"],
      "properties": {
        "items": { "type": "string", "description": "path from the document to the camera array; empty when the document is the array" },
        "id": { "type": "string" },
        "lat": { "type": "string" },
        "lon": { "type": "string" },
        "image": { "type": "string", "description": "path to the image URL, or to the value put into image_template" },
        "name": { "type": "string" },
        "active": { "type": "string", "description": "path to a flag; items where it is not true are skipped" },
        "image_template": { "type": "string", "pattern": "^https://[!-~]+$", "description": "image URL with {value} replaced by the URL-encoded image value" }
      }
    },
    "perimeterMapping": {
      "description": "geojson.fire-perimeters: which feature property holds each field, and the region the feed covers.",
      "type": "object",
      "required": ["id", "size_ha", "updated", "region"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "description": "property with the fire number" },
        "size_ha": { "type": "string", "minLength": 1, "description": "property with the size in hectares" },
        "updated": { "type": "string", "minLength": 1, "description": "property with the date the perimeter was mapped: epoch milliseconds or YYYY-MM-DD[Z]" },
        "status": { "type": "string", "minLength": 1, "description": "property with the fire's status as the source reports it, when it has one" },
        "url": { "type": "string", "minLength": 1, "description": "property with the fire's incident page, when the source has one" },
        "region": { "type": "string", "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$", "description": "ISO 3166-2 code of the area the feed covers" }
      }
    }
  },
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
    "domain": { "enum": ["transit.vehicles", "bikeshare.stations", "hazards.earthquakes", "cameras.stills", "sharedmobility.vehicles", "hazards.disasters", "hazards.fires", "hazards.perimeters"] },
    "name": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "coverage": {
      "type": "object",
      "required": ["bbox", "countries"],
      "properties": {
        "bbox": {
          "description": "[minLat, minLon, maxLat, maxLon]",
          "oneOf": [
            { "type": "null" },
            {
              "type": "array",
              "prefixItems": [{ "$ref": "#/$defs/lat" }, { "$ref": "#/$defs/lon" }, { "$ref": "#/$defs/lat" }, { "$ref": "#/$defs/lon" }],
              "items": false,
              "minItems": 4
            }
          ]
        },
        "countries": { "type": "array", "items": { "type": "string" } },
        "class": {
          "description": "Size class of the box; absent means regional. Limits: conformance/cases.json coverage.limits.",
          "enum": ["regional", "national", "global"]
        }
      }
    },
    "access": {
      "type": "object",
      "required": ["url", "redirectHosts", "unzip", "headers", "min_interval_s"],
      "properties": {
        "url": { "$ref": "#/$defs/httpUrl" },
        "related": { "type": "object", "additionalProperties": { "$ref": "#/$defs/httpUrl" } },
        "redirectHosts": { "type": "array", "items": { "type": "string" } },
        "unzip": { "type": ["string", "null"] },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } },
        "min_interval_s": { "type": "number", "minimum": 0 }
      }
    },
    "format": { "enum": ["gtfs-rt.vehicle-positions", "gbfs.station-status", "geojson.earthquakes", "cameras.list", "gbfs.vehicle-status", "geojson.gdacs-events", "csv.firms-active-fire", "geojson.fire-perimeters"] },
    "licence": {
      "type": "object",
      "required": ["id", "url", "display", "commercial", "attribution"],
      "properties": {
        "id": { "type": ["string", "null"] },
        "url": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/httpUrl" }] },
        "display": { "type": "boolean" },
        "commercial": { "type": ["boolean", "null"] },
        "attribution": { "type": ["string", "null"] },
        "obligations": {
          "description": "Set by a tier-2 (llm-terms) decision: the kinds of conditions the terms impose, all ones an app meets on its own.",
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "licence_decision": {
      "type": "object",
      "required": ["by", "evidence"],
      "properties": {
        "by": { "enum": ["known-licence", "gbfs-v3-default", "llm-terms", "none"] },
        "evidence": { "type": "array", "items": { "type": "object" } },
        "terms_sha256": { "type": ["string", "null"] },
        "at": { "type": ["string", "null"] }
      }
    },
    "provenance": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "gbfs": {
      "description": "GBFS entries: the system and spec version; vehicles entries also list form_factors (empty means unknown).",
      "type": "object",
      "properties": {
        "system_id": { "type": ["string", "null"] },
        "version": { "type": ["string", "null"] },
        "catalogue_licence": { "$ref": "#/$defs/httpUrl" },
        "form_factors": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["bicycle", "cargo_bicycle", "car", "moped", "scooter_standing", "scooter_seated", "other"] }
        }
      }
    },
    "mapping": {
      "description": "Where a list's fields sit, for formats that read one: cameras.list ($defs/cameraMapping) and geojson.fire-perimeters ($defs/perimeterMapping).",
      "type": "object"
    },
    "health": {
      "description": "Present in published directories, not in entries/. Probe summary over the last 7 days.",
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["candidate", "verified", "degraded", "dead"] },
        "success_7d": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "median_age_s": { "type": ["number", "null"] },
        "records": { "type": ["number", "null"] },
        "last_ok": { "type": ["number", "null"], "description": "epoch seconds of the last probe with records" },
        "last_probe": { "type": ["number", "null"], "description": "epoch seconds" }
      }
    }
  }
}
